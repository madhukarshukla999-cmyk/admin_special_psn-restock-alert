{
  "manifest_version": 3,
  "name": "PSN Stock Bot – fast checkout",
  "version": "1.7.0",
  "description": "Opens PlayStation gift card restocks from your Telegram bot instantly and takes you to checkout. You always pay yourself.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://ntfy.sh/*",
    "https://www.gamestheshop.com/*",
    "https://www.amazon.in/*",
    "https://secure.paytmpayments.com/*",
    "https://securegw.paytm.in/*",
    "https://*.amazon.in/*",
    "https://api.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "PSN Stock Bot",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gamestheshop.com/*",
        "https://www.amazon.in/*",
        "https://secure.paytmpayments.com/*",
        "https://securegw.paytm.in/*",
        "https://*.amazon.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
