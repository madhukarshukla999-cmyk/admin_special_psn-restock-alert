# Copy to .env and fill in.
# 1. Create a bot: open Telegram, message @BotFather, send /newbot, copy the token.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# 2. Your chat ID (from @userinfobot). This chat is the bot's owner.
#    Several owners? Separate with commas.
TELEGRAM_CHAT_ID=123456789

# 3. Optional: email alerts. Gmail needs an App Password
#    (Google Account -> Security -> 2-Step Verification -> App passwords), not your normal password.
#    Then anyone with access can send /email you@example.com to the bot.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=PSN Bot <you@gmail.com>

# WhatsApp alerts need nothing here: each person sends /whatsapp to the Telegram bot.

# GTSbuy screenshots (optional): after a GTSbuy payment (and on "🔄 I paid – check now") the server
# opens GamesTheShop in a headless Chromium, logged in as that account, and sends a screenshot of
# the order. Uses ~150-300 MB RAM while it runs; on a 1 GB VM add swap first. After adding it,
# run `sudo bash deploy/install.sh` (installs Playwright + Chromium once, a few minutes).
# GTS_SCREENSHOT=1
